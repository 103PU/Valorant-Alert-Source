{
  // The .mjs extension is load-bearing: it declares ES-module format without a
  // "type" field in the repo package.json, which is CommonJS. Cloudflare only
  // accepts module workers, and Node reparses a typeless .js as ESM with a warning.
  // Deploy with `npx wrangler deploy` from this directory. wrangler is NOT a
  // dependency of the app — it is fetched on demand, so nothing here lands in
  // package.json or in the shipped binary. (`tools` is already in caxa's
  // --exclude list, see scripts/build.js.)
  "name": "discord-proxy",
  "account_id": "4321e023cd6616f23130d36409e889e0",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-04",

  "vars": {
    // Route names are the only destination selector callers can choose. Keep this
    // non-secret registry small and deploy with --keep-vars to retain the live
    // ValorantTweaks DISCORD_CHANNEL_ID binding during the shared Worker update.
    "DISCORD_ROUTES": {
      "valorant-tweaks": {
        "channelBinding": "DISCORD_CHANNEL_ID",
        "tokenBinding": "AUTH_TOKEN",
        "crosspost": true
      },
      "valorant-alert": {
        "channelId": "1555280650096087150",
        "tokenBinding": "ALERT_AUTH_TOKEN"
      }
    }
  },

  // Secrets (never in this file — `npx wrangler secret put <NAME>`):
  //   DISCORD_BOT_TOKEN  shared bot token; preserve the existing Worker secret.
  //   AUTH_TOKEN         existing ValorantTweaks route token; preserve it.
  //   ALERT_AUTH_TOKEN   new, separate route token for Valorant Alert.

  "observability": { "enabled": true }
}
